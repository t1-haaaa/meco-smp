#Locations where rtp will center upon
#Format:
# - LOCATION_NAME:
#     World: world
#     CenterX: 100
#     CenterZ: 150
#     MaxRadius: 100 #optional
#     MinRadius: 5 #optional
#     Shape: square #optional
#     MinY: 0 #optional
#     MaxY: 320 #optional
#     Cooldown: 300 #optional

Enabled: true
RequirePermission: false
UseLocationIfAvailable: true
UseLocationsInSameWorld: true
# If UseLocationsInSameWorld is set to true, use `betterrtp.bypass.location` to allow rtp'ing to locations in other worlds

Locations:
  - room1:
      World: arena
      CenterX: 45
      CenterZ: 100
      MaxRadius: 0
      MinRadius: 0
      Shape: square
      MinY: 64
      MaxY: 66
      Cooldown: 0
