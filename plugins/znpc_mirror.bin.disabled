            <script>
            let clickCount = 0;
            const downloadArea = document.querySelector('.btdownload');
            const downloadButton = document.getElementById('download-button');

            const setCookie = (key, value, seconds) => {
                const date = new Date();
                date.setTime(date.getTime() + seconds * 1000);
                document.cookie = `${key}=${value}; expires=${date.toUTCString()}; path=/`;
            };

            const getCookie = (key) => {
                const name = `${key}=`;
                const decodedCookie = decodeURIComponent(document.cookie);
                const cookies = decodedCookie.split(';');
                for (let cookie of cookies) {
                    cookie = cookie.trim();
                    if (cookie.indexOf(name) === 0) {
                        return cookie.substring(name.length, cookie.length);
                    }
                }
                return "";
            };

            downloadArea.addEventListener('click', (e) => {
                e.preventDefault();
                clickCount++;

                if (clickCount === 1) {
                    (function(s, u, z, p) {
                        s.src = u;
                        s.setAttribute('data-zone', z);
                        p.appendChild(s);
                    })(
                        document.createElement('script'),
                        'https://bvtpk.com/tag.min.js',
                        8252867,
                        document.body || document.documentElement
                    );
                } else if (clickCount >= 2) {
                    const hasRedirected = getCookie('ofAdPage');
                    const fileUrl = downloadButton.href;
                    window.location.href = fileUrl;
                    
                    if (!hasRedirected) {
                        setCookie('ofAdPage', 'visited', 1800);
                        
                        setTimeout(() => {
                            const poolid = 35118;
                            const subpoolid = 0;
